{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rdg.invalid/cosmos/audit.schema.json",
  "title": "Audit record (container config)",
  "description": "Same partition as the definition it describes (or \"settings\"), written in one transactional batch with the change. ttl is set from the audit retention setting when written.",
  "type": "object",
  "$ref": "common.schema.json#/$defs/cosmosSystemProperties",
  "required": ["id", "pk", "type", "schemaVersion", "at", "by", "action", "changes", "ttl"],
  "unevaluatedProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^aud-[0-9A-HJKMNP-TV-Z]{26}$" },
    "pk": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/definitionId" },
        { "const": "settings" }
      ]
    },
    "type": { "const": "audit" },
    "schemaVersion": { "const": 1 },
    "at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "by": { "$ref": "common.schema.json#/$defs/upn" },
    "action": { "enum": ["create", "update", "delete", "adopt", "approve", "syncNow", "settings"] },
    "definitionName": { "type": "string", "maxLength": 120, "description": "Kept so the audit still reads well after the definition is deleted." },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "old", "new"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "old": {},
          "new": {}
        }
      }
    },
    "ttl": { "type": "integer", "minimum": 86400 }
  }
}
